@model RecipeHub.Mvc.Models.RecipeIngredient

@{
    ViewData["Title"] = "Add Ingredient to Recipe";
}

<h1>Add Ingredient to Recipe</h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="RecipeId" class="control-label">Recipe</label>
                <select asp-for="RecipeId" class="form-control"
                        asp-items="@(ViewBag.Recipes)">
                    <option value="">-- Select Recipe --</option>
                </select>
                <span asp-validation-for="RecipeId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="IngredientId" class="control-label">Ingredient</label>
                <select asp-for="IngredientId" class="form-control"
                        asp-items="@(ViewBag.Ingredients)">
                    <option value="">-- Select Ingredient --</option>
                </select>
                <span asp-validation-for="IngredientId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Quantity" class="control-label">Quantity</label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Unit" class="control-label">Unit</label>
                <input asp-for="Unit" class="form-control" placeholder="e.g. grams, cups, ml" />
                <span asp-validation-for="Unit" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Add Ingredient" class="btn btn-primary" />
            </div>

        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>